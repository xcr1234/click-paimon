# Public repository allowlist. Local game workspaces, settings, logs, backups,
# downloads and generated files remain on disk but are not published.
*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/package.json
!/package-lock.json
!/.github/
!/.github/**
!/src/
!/src/**
!/game/
!/game/ui.save.json
!/game/tests/
!/game/tests/*.json
!/assets/
!/assets/cover.png
!/assets/result.png
!/tools/
!/tools/bundle-lua.mjs
!/tools/build-project.mjs
!/tools/export-project.mjs
!/tools/audit-public.mjs
!/tools/miliastra-toolbox-mcp.mjs
!/scripts/
!/scripts/test-lua-bundle.mjs
!/docs/
!/docs/lua-modules.md
!/docs/game-import.md
!/docs/development.md
!/examples/
!/examples/lua-modular/
!/examples/lua-modular/src/
!/examples/lua-modular/src/**

# These stay private even inside an otherwise public source directory.
**/.env
**/.env.*
**/*.local.*
**/*.log
**/*.pem
**/*.key
**/node_modules/
